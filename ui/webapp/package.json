{
  "name": "landscape",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite --host",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:diff": "prettier --list-different \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "lint": "oxlint --config ../../.oxlintrc.json --deny-warnings src && eslint src --max-warnings 0",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --deny-warnings --fix src && eslint src --max-warnings 0 --fix",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@popperjs/core": "^2.11.8",
    "@solid-primitives/resize-observer": "^2.2.0",
    "@solid-primitives/scroll": "^2.1.6",
    "@solidjs/router": "^1.0.0",
    "apexcharts": "^8.5.0",
    "bootstrap": "^5.3.8",
    "common": "link:../common",
    "lodash": "^4.18.1",
    "minisearch": "^7.2.0",
    "moment": "^2.31.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/eslint-parser": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.5",
    "ejs": "^7.0.2",
    "eslint": "^10.13.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-solid": "^0.18.1",
    "jsdom": "^30.1.3",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-ejs": "^2.0.0",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  },
  "description": "Landscape2 is a tool that generates interactive landscapes websites.",
  "license": "Apache-2.0"
}
