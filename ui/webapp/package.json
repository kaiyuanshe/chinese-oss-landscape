{
  "name": "landscape",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "dev": "vite --host",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:diff": "prettier --list-different \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "lint": "eslint src --max-warnings 0",
    "lint:fix": "eslint src --max-warnings 0 --fix",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@solid-primitives/resize-observer": "^2.1.5",
    "@solid-primitives/scroll": "^2.1.5",
    "@solidjs/router": "^1.0.0",
    "add": "^2.0.6",
    "apexcharts": "8.3.1",
    "bootstrap": "5.3.8",
    "common": "link:../common",
    "lodash": "^4.18.1",
    "minisearch": "^7.2.0",
    "moment": "^2.31.0",
    "solid-apexcharts": "^0.6.0",
    "solid-js": "^1.9.17",
    "yarn": "^2.4.3"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.26",
    "ejs": "^3.1.10",
    "eslint": "^10.12.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-solid": "^0.18.1",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.3.0",
    "prettier": "^3.9.10",
    "sass": "1.105.1",
    "ts-jest": "^29.4.9",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.58.1",
    "vite": "^8.3.4",
    "vite-plugin-ejs": "^2.0.0",
    "vite-plugin-solid": "^2.11.14"
  },
  "description": "Landscape2 is a tool that generates interactive landscapes websites.",
  "license": "Apache-2.0"
}
