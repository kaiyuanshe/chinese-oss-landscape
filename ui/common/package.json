{
  "name": "common",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "format:diff": "prettier --list-different \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\"",
    "lint": "oxlint --config ../../.oxlintrc.json --deny-warnings src && eslint src --max-warnings 0",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --deny-warnings --fix src && eslint src --max-warnings 0 --fix"
  },
  "dependencies": {
    "@solid-primitives/resize-observer": "^2.2.0",
    "lodash": "^4.18.1",
    "moment": "^2.31.0",
    "sanitize-html": "^2.18.1",
    "solid-js": "^1.9.17",
    "solid-styled-components": "^0.28.5"
  },
  "devDependencies": {
    "@babel/core": "^8.0.9",
    "@babel/eslint-parser": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "@types/lodash": "^4.17.27",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "esbuild": "^0.28.2",
    "esbuild-plugin-solid": "^0.6.0",
    "eslint": "^10.13.0",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-solid": "^0.18.1",
    "oxlint": "^1.90.0",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.5"
  },
  "exports": {
    "solid": "./dist/index.jsx",
    "import": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "require": {
      "types": "./dist/index.d.cts",
      "default": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "browser": {},
  "typesVersions": {}
}
